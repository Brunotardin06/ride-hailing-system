<mxfile host="app.diagrams.net">
  <diagram id="arch-v2" name="Architecture v2">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Personas -->
        <mxCell id="user" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;(passenger)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="driverP" value="&lt;b&gt;DRIVER&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="40" height="70" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="web" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;React" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Services -->
        <mxCell id="realtime" value="&lt;b&gt;Realtime Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;push · chat · driver location&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="690" y="30" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="drv" value="&lt;b&gt;Driver Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="160" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ride" value="&lt;b&gt;Ride Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="400" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="matching" value="&lt;b&gt;Matching Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="960" y="160" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- Brokers -->
        <mxCell id="rmq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="690" y="280" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kafka" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;driver-locations&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e6e6e6;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="967" y="35" width="156" height="50" as="geometry" />
        </mxCell>

        <!-- Databases -->
        <mxCell id="drvdb" value="Drivers DB&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PostgreSQL&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="245" width="80" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ridedb" value="Rides DB&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;PostgreSQL&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="485" width="80" height="70" as="geometry" />
        </mxCell>

        <!-- Personas -> Web App -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="user" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="driverP" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- REST -->
        <mxCell id="e3" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F6FEB;fontColor=#1F6FEB;strokeWidth=2;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="drv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F6FEB;fontColor=#1F6FEB;strokeWidth=2;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="ride">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SignalR -->
        <mxCell id="e5" value="SignalR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#8250DF;fontColor=#8250DF;strokeWidth=2;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="realtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- gRPC Driver -> Ride -->
        <mxCell id="e7" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2DA44E;fontColor=#2DA44E;strokeWidth=2;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="drv" target="ride">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RabbitMQ -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#F07800;strokeWidth=2;dashed=1;exitX=1;exitY=0.8;entryX=0.25;entryY=0;" edge="1" parent="1" source="drv" target="rmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#F07800;strokeWidth=2;dashed=1;exitX=0;exitY=0.25;entryX=0.9;entryY=1;" edge="1" parent="1" source="rmq" target="drv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#F07800;strokeWidth=2;dashed=1;exitX=1;exitY=0.25;entryX=0.25;entryY=1;" edge="1" parent="1" source="ride" target="rmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#F07800;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="rmq" target="matching">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#F07800;strokeWidth=2;dashed=1;exitX=0.75;exitY=0;entryX=0.66;entryY=1;" edge="1" parent="1" source="rmq" target="realtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- gRPC Matching -> Driver (drawn after e12 so its crossing gets the jump arc) -->
        <mxCell id="e6" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2DA44E;fontColor=#2DA44E;strokeWidth=2;fontStyle=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.3;entryX=1;entryY=0.3;" edge="1" parent="1" source="matching" target="drv">
          <mxGeometry x="-0.6" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>


        <!-- Kafka: Realtime produces GPS positions, Realtime + Matching consume them (two consumer groups) -->
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="realtime" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="kafka" target="realtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="kafka" target="matching">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Databases -->
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;exitX=0.29;exitY=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="drv" target="drvdb">
          <mxGeometry relative="1" as="geometry" />
