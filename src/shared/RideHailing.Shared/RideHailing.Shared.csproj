<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code shared by all services: message contracts, the RabbitMQ plumbing
    (topology, publisher, consumer), the outbox, and the Kafka driver-location stream.
    Business logic stays inside each service.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

</Project>
