{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ServiceUrls": {
    "DriverService": "http://localhost:5002",
    "DriverServiceGrpc": "http://localhost:5012"
  },
  "DriverLookup": {
    "Mode": "Rest"
  },
  "Matching": {
    "MaxAttempts": 3,
    "CandidatesPerLookup": 5
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "ridehailing",
    "Password": "ridehailing",
    "MaxRetries": 3,
    "PrefetchCount": 10
  },
  "Metrics": {
    "Enabled": true,
    "AnalyticsUrl": "http://localhost:5005",
    "FlushIntervalMs": 2000
  }
}
