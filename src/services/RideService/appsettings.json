{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rides;Username=ridehailing;Password=ridehailing"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "ridehailing",
    "Password": "ridehailing",
    "MaxRetries": 3,
    "PrefetchCount": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "ride-events",
    "Partitions": 3
  },
  "Metrics": {
    "Enabled": true,
    "AnalyticsUrl": "http://localhost:5005",
    "FlushIntervalMs": 2000
  },
  "ServiceUrls": {
    "MatchingService": "http://localhost:5003",
    "MatchingExperiment": "http://localhost:5013"
  },
  "Matching": {
    "Mode": "RabbitMq",
    "RestTimeoutMs": 3000
  }
}
