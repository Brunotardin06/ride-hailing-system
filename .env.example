# Copy this file to .env (docker compose reads .env automatically).
# All values below are local development defaults — never use them in production.

# PostgreSQL
POSTGRES_USER=ridehailing
POSTGRES_PASSWORD=ridehailing
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=ridehailing
RABBITMQ_PASSWORD=ridehailing
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Kafka (host-facing listener)
KAFKA_PORT=9092

# Backend service host ports (each container listens on 8080 internally)
RIDE_SERVICE_PORT=5001
DRIVER_SERVICE_PORT=5002
DRIVER_SERVICE_GRPC_PORT=5012
MATCHING_SERVICE_PORT=5003
REALTIME_SERVICE_PORT=5004
ANALYTICS_SERVICE_PORT=5005
MATCHING_EXPERIMENT_PORT=5013

# Experiment settings
# Matching path for normal (demo) rides: RabbitMq (asynchronous) or Rest (synchronous)
RIDE_MATCHING_MODE=RabbitMq
# Transport MatchingService uses for the driver-availability lookup: Rest or Grpc
DRIVER_LOOKUP_MODE=Rest
# Seconds a driver has to accept or reject an offer
OFFER_TIMEOUT_SECONDS=30
